# Runtime credentials — what the API actually connects as. Must be the
# restricted "wardlink_app" role (NOSUPERUSER, NOBYPASSRLS), never
# "postgres" — a superuser silently bypasses Row-Level Security entirely.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=wardlink_app
DB_PASSWORD=app_password_change_me
DB_NAME=wardlink_ng
PORT=3000

# Admin credentials — only used by the TypeORM CLI (data-source.ts) to run
# migrations, since creating tables/roles/policies needs elevated
# privileges. Never used by the running app itself.
ADMIN_DB_USERNAME=postgres
ADMIN_DB_PASSWORD=postgres
# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h